# Copy to .env (in the project root) and fill in OPENAI_API_KEY. Never commit .env.
# Relative paths are resolved from the project root, not the current directory.
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db
# The date the service treats as "today" for every business rule (YYYY-MM-DD).
APP_TODAY=2026-07-01
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# Maximum tool calls the assistant may make for one customer message.
MAX_TOOL_CALLS=6
